VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Domínio dos logins da equipe: quem digita só "nome.sobrenome" entra como nome.sobrenome@empresa.com.br.
VITE_DEFAULT_EMAIL_DOMAIN=@empresa.com.br

# Modo Portfólio / Demonstração: true roda o app com dados fictícios guardados no navegador,
# sem conectar ao Supabase (as chaves acima podem ficar vazias). Use false em produção.
VITE_DEMO_MODE=false

# Opcional: Cloudflare Turnstile (captcha no login e na recuperação de senha).
# Ative também em Supabase → Authentication → Attack Protection → CAPTCHA, com a chave secreta.
VITE_TURNSTILE_SITE_KEY=
